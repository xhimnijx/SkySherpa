# Copy to .env (git-ignored). Every value has a sane default; this file is for tuning.

# Where the 24/7 observation store lives. Defaults to ./data
# SKYSHERPA_HOME=C:\vatsim-route-planner\data

# Poll cadence for the live network feed, in seconds.
# The upstream feed regenerates every 15s. 30s is the default: 1.3 MB/snapshot,
# ~3.7 GB/month of transfer at 30s. Do not go below 15s. Be a good citizen.
# SKYSHERPA_POLL_SECONDS=30

# Identify yourself. VATSIM's edge will throttle anonymous bursts regardless,
# but a real contact string is the polite default.
# SKYSHERPA_USER_AGENT=SkySherpa/0.1 (+you@example.com)

# Retention: how long to keep identifiable pilot rows before pseudonymisation
# is irreversible for old data. See docs/decisions.md (ADR-0003).
# SKYSHERPA_RETENTION_DAYS=180

# Optional integrations (leave blank to disable)
# SIMBRIEF_USERNAME=
# SIMBRIEF_KEY=
# VATSIM_CONNECT_CLIENT_ID=
# VATSIM_CONNECT_CLIENT_SECRET=
